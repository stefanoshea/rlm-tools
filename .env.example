# Local exploration defaults to the server launch directory.
# RLM_ALLOWED_ROOTS=/absolute/path/to/repository

# To send prompts, context, and recursive tool output to Anthropic, Gemini,
# or an OpenAI-compatible API, set RLM_EXTERNAL_ROOTS and provider config.
# RLM_EXTERNAL_ROOTS=/absolute/path/to/shareable-repository
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# Optional custom Chat Completions base URL (OpenRouter, Ollama, vLLM, LM Studio, Gemini OpenAI-compat, etc.)
# Can be used without OPENAI_API_KEY for keyless local endpoints such as http://localhost:11434/v1
# OPENAI_BASE_URL=

# Optional: sub-LLM provider selection ('auto', 'anthropic', 'gemini', or 'openai'; default: 'auto')
# Auto checks keys in order: ANTHROPIC_API_KEY -> GEMINI_API_KEY -> OPENAI_API_KEY / OPENAI_BASE_URL.
# RLM_SUB_PROVIDER=auto

# Optional: override the sub-LLM model
# Defaults: claude-haiku-4-5-20251001 (Anthropic), gemini-3.5-flash-lite (Gemini), gpt-4.1-mini (OpenAI)
# RLM_SUB_MODEL=

# To also enable the recursive evidence gate, set RLM_RECURSE_GATE=1 with
# TYPESAFE_API_KEY (TypeSafe) or GEMINI_API_KEY (Gemini Decisions API).
# RLM_RECURSE_GATE=1
# RLM_GATE_PROVIDER=auto
# TYPESAFE_API_KEY=
# GEMINI_DECISION_MODEL=gemini-decision-1

# Optional: max concurrent sessions (default: 5)
# RLM_MAX_SESSIONS=5

# Optional: session inactivity timeout in minutes (default: 10)
# RLM_SESSION_TIMEOUT=10
