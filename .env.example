# Required for llm_query() / llm_query_batched() / rlm_recurse() / rlm_recurse_batched()
# Optional — server works without it, just no sub-LLM capability
ANTHROPIC_API_KEY=sk-ant-...

# Optional: enables the TypeSafe (Jev) evidence gate for rlm_recurse()
# Requires `rlm-tools[semantic]` and ANTHROPIC_API_KEY
# TYPESAFE_API_KEY=ts-...
# TYPESAFE_DEFAULT_MODEL=jev-latest
# RLM_RECURSE_GATE=1

# Optional: override the sub-LLM model (default: claude-haiku-4-5-20251001)
# RLM_SUB_MODEL=claude-haiku-4-5-20251001

# Optional: per-request sub-LLM timeout in seconds and retry attempts
# RLM_SUB_TIMEOUT_SECONDS=60
# RLM_SUB_MAX_RETRIES=3

# Optional: max recursion depth for rlm_recurse() child agents (default: 2)
# RLM_RECURSE_MAX_DEPTH=2

# Optional: max concurrent sessions (default: 5)
# RLM_MAX_SESSIONS=5

# Optional: session inactivity timeout in minutes (default: 10)
# RLM_SESSION_TIMEOUT=10
